# stored configuration values

fb_bindir=/opt/firebird/bin
fb_libdir=/opt/firebird/lib
fb_incdir=/opt/firebird/include
fb_udfdir=/opt/firebird/UDF
fb_sbindir=/opt/firebird/bin
fb_confdir=/opt/firebird
fb_docdir=/opt/firebird/doc
fb_sampledir=/opt/firebird/examples
fb_sampledbdir=/opt/firebird/examples/empbuild
fb_helpdir=/opt/firebird/help
fb_intldir=/opt/firebird/intl
fb_miscdir=/opt/firebird/misc
fb_securedbdir=/opt/firebird
fb_msgdir=/opt/firebird
fb_logdir=/opt/firebird
fb_glockdir=/opt/firebird
fb_pluginsdir=/opt/firebird/plugins

fb_cflags="-I$fb_incdir"
fb_libs="-L$fb_libdir -lfbclient"
fb_embedlibs="-L$fb_libdir -lfbembed"

BuildVersion=2.5.9.27139
PackageVersion=0
CpuType=amd64

Version="$BuildVersion-$PackageVersion.$CpuType"

fb_version=$Version


usage() {
  cat <<EOF

Usage $0 [Options]

Where Options are:
     --cflags
     --libs
     --embedlibs
     --bindir
     --udfdir
     --sbindir
     --confdir
     --docdir
     --sampledir
     --sampledbdir
     --helpdir
     --intldir
     --miscdir
     --securedbdir
     --msgdir
     --logdir
     --glockdir
     --pluginsdir
     --version
EOF
}

if test "$#" -eq 0 ; then
    usage
    exit 1
fi


while test $# -gt 0
  do
    case "$1" in
        --cflags) echo $fb_cflags ;;
        --libs) echo $fb_libs ;;
        --embedlibs) echo $fb_embedlibs ;;
        --bindir) echo $fb_bindir ;;
        --udfdir) echo $fb_udfdir ;;
        --sbindir) echo $fb_sbindir ;;
        --confdir) echo $fb_confdir ;;
        --docdir) echo $fb_docdir ;;
        --sampledir) echo $fb_sampledir ;;
        --helpdir) echo $fb_helpdir ;;
        --intldir) echo $fb_intldir ;;
        --miscdir) echo $fb_miscdir ;;
        --securedbdir) echo $fb_securedbdir ;;
        --msgdir) echo $fb_msgdir ;;
        --logdir) echo $fb_logdir ;;
        --glockdir) echo $fb_glockdir ;;
        --pluginsdir) echo $fb_pluginsdir ;;
        --sampledbdir) echo $fb_sampledbdir ;;
        --version) echo $fb_version ;;
        --help) usage ;;
        *) usage ;
    esac
    shift
  done
